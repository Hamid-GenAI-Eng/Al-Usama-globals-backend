// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  email           String   @unique
  password        String
  fullName        String
  role            Role     @default(TRADE_AGENT)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  shipments       Shipment[]
  documents       Document[]
  auditLogs       AuditLog[]
}

enum Role {
  MASTER_ADMIN
  OPS_MANAGER
  TRADE_AGENT
  CLIENT
}

model Shipment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  shipmentId      String   @unique
  origin          String
  destination     String
  vesselName      String?
  departureDate   DateTime?
  arrivalDate     DateTime?
  status          ShipmentStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
  documents       Document[]
  statusLogs      ShipmentStatusLog[]
}

enum ShipmentStatus {
  PENDING
  ORDER_CONFIRMED
  IN_TRANSIT
  CUSTOMS_CLEARANCE
  DELIVERED
  DELAYED
}

model ShipmentStatusLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  shipmentId      String   @db.ObjectId
  shipment        Shipment @relation(fields: [shipmentId], references: [id])
  status          ShipmentStatus
  description     String?
  timestamp       DateTime @default(now())
}

model Document {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  type            String
  fileUrl         String
  cloudinaryId    String
  shipmentId      String?  @db.ObjectId
  shipment        Shipment? @relation(fields: [shipmentId], references: [id])
  userId          String   @db.ObjectId
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String?  @db.ObjectId
  user            User?    @relation(fields: [userId], references: [id])
  action          String
  target          String
  module          String
  ipAddress       String?
  timestamp       DateTime @default(now())
}

model Contact {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  type            ContactType
  email           String?
  phone           String?
  address         String?
  country         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]
}

enum ContactType {
  SUPPLIER
  BUYER
}

model Order {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String   @unique
  type            OrderType
  date            DateTime @default(now())
  status          String   @default("DRAFT")
  totalAmount     Float    @default(0)
  currency        String   @default("PKR")
  contactId       String   @db.ObjectId
  contact         Contact  @relation(fields: [contactId], references: [id])
  items           OrderItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrderItem {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String   @db.ObjectId
  order           Order    @relation(fields: [orderId], references: [id])
  hsCode          String?
  description     String
  quantity        Int
  unitPrice       Float
  totalPrice      Float
}

enum OrderType {
  PURCHASE
  SALES
}

model ExchangeRate {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  currencyCode    String   @unique
  rateToPkr       Float
  source          String   @default("SBP")
  updatedAt       DateTime @updatedAt
}
